# ==============================================================================
# EduPulse Student Management System (SMS) - Environment Configuration Template
# DO NOT commit real secrets or production passwords into version control.
# Copy this file to .env and supply your local or institutional credentials.
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Direct PostgreSQL Pooler Connection (Required for running database migrations & seed scripts)
# Format: postgresql://postgres.[project-ref]:[DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
